{
  "name": "micro-saas-base-template",
  "private": true,
  "version": "0.0.0",
  "description": "Micro SaaS base template with Hexagonal Architecture, DDD, and multi-app delivery.",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "corepack pnpm --filter @apps/portal dev",
    "dev:portal": "corepack pnpm --filter @apps/portal dev",
    "dev:admin": "corepack pnpm --filter @apps/admin dev",
    "build": "corepack pnpm -r --if-present build",
    "lint": "corepack pnpm -r --if-present lint",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "corepack pnpm -r --if-present test",
    "format:check": "corepack pnpm -r --if-present format:check"
  }
}
